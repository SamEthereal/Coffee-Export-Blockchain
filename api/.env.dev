# ==============================================================================
# CECBS API - Fast Local Development Environment (Tier 1: Fast Dev Mode)
# ==============================================================================

# Server Config
NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3001/api/v1
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3003

# Strong JWT Secret for Development (minimum 32 chars, not a weak default)
JWT_SECRET=cecbs-dev-super-secure-cryptographic-jwt-token-secret-key-2026-ethiopia
JWT_EXPIRY=24h

# Database Configuration (matches docker-compose.dev.yml)
DATABASE_URL=postgresql://cecbs:cecbs123@localhost:5432/cecbs
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cecbs
DB_USER=cecbs
DB_PASSWORD=cecbs123

# Redis Configuration (matches docker-compose.dev.yml)
REDIS_HOST=localhost
REDIS_PORT=6379

# Hybrid IPFS Configuration (matches docker-compose.dev.yml)
IPFS_HOST=localhost
IPFS_PORT=5001
IPFS_GATEWAY=http://localhost:8080/ipfs
IPFS_PROTOCOL=http

# Hyperledger Fabric Simulation Mode (Fast Dev Mode)
# When set to false, FabricService activates its built-in Simulated Ledger Engine:
#   - Zero blockchain peer crashes or timeouts
#   - Simulates valid transactions, endorsements, and cryptographic hashes
#   - Full data persistence and relational querying via PostgreSQL
FABRIC_ENABLED=false
FABRIC_REQUIRED=false
MOCK_LEDGER=true
FABRIC_CHANNEL_NAME=coffeechannel
FABRIC_CHAINCODE_NAME=coffee
FABRIC_MSP_ID=ECTAMSP

# Logging & Performance
LOG_LEVEL=info
ENABLE_BLOCKCHAIN_EXPLORER=true
ENABLE_METRICS=true
